{
  "_template": "skydiao 节点扩展模板：复制本文件、改掉 manifest.id 就能做成一个新的扩展包，用节点图编辑器的「导入扩展」按钮载入。注意：type 的 id 必须与 Java 侧节点类 getType() 返回的字符串一致；与 default 扩展重复的 type id 会被编辑器跳过。",
  "manifest": {
    "id": "skydiao",
    "name": "skydiao",
    "version": "1.0.0",
    "minEditor": 1,
    "description": "Skydiao模组自定义节点扩展模板：在此声明本模组专属的入口节点，执行逻辑在 Java 侧的对应节点类里实现。"
  },
  "categories": [
    { "id": "skydiao_event", "label": "SkyDiao事件" },
    { "id": "skydiao_chat", "label": "SkyDiao聊天" },
    { "id": "skydiao_server", "label": "SkyDiao服务器相关" }
  ],
  "types": {
    "on_tick_start": {
      "category": "skydiao_event",
      "label": "每刻触发",
      "color": "#2e7d32",
      "execIn": false,
      "execOut": [{ "id": "out", "label": "执行" }],
      "in": [],
      "out": [],
      "desc": "入口节点：游戏每刻（tick）触发一次执行。"
    },
    "on_chat_message": {
      "category": "skydiao_event",
      "label": "收到聊天",
      "color": "#2e7d32",
      "execIn": false,
      "execOut": [{ "id": "out", "label": "执行" }],
      "in": [],
      "out": [{ "id": "msg", "label": "消息", "type": "string" }],
      "desc": "入口节点：收到聊天消息时触发执行，可匹配关键词。"
    },
    "on_nodegraph_load": {
      "category": "skydiao_event",
      "label": "当节点图被加载",
      "color": "#2e7d32",
      "execIn": false,
      "execOut": [{ "id": "out", "label": "执行" }],
      "in": [],
      "out": [],
      "desc": "入口节点：节点图加载或重载完成后触发执行。"
    },
    "on_level_change": {
      "category": "skydiao_event",
      "label": "当世界变化时",
      "color": "#2e7d32",
      "execIn": false,
      "execOut": [{ "id": "out", "label": "执行" }],
      "in": [],
      "out": [],
      "desc": "入口节点：世界变化时触发执行。"
    },
    "print_chat_message": {
      "category": "skydiao_chat",
      "label": "打印聊天消息",
      "color": "#e051c8",
      "execIn": true,
      "execOut": [{ "id": "out", "label": "执行" }],
      "in": [{ "id": "msg", "label": "消息", "type": "string", "default": "OvO" }],
      "out": [],
      "desc": "在游戏中打印聊天消息。"
    },
    "get_server_self_online_info": {
      "category": "skydiao_server",
      "label": "取自身Hypixel在线状态",
      "color": "#ff5454",
      "execIn": true,
      "execOut": [{ "id": "out", "label": "执行" }],
      "in": [],
      "out": [
        { "id": "is_online", "label": "是否在线", "type": "bool" },
        { "id": "game_type", "label": "游戏类型", "type": "string" },
        { "id": "game_mode", "label": "游戏模式", "type": "string" },
        { "id": "lobby_name", "label": "大厅名称", "type": "string" },
        { "id": "server_id", "label": "服务器ID", "type": "string" }
      ],
      "desc": "获取自身Hypixel在线状态信息，例如是否在Hypixel服务器内、游戏类型、游戏模式、大厅名称、服务器ID等。"
    }
  }
}